{
  "name": "dsh-mobile",
  "version": "0.1.1",
  "description": "Responsive mobile web layout for DeepSeek Harness",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
